# ========================================================
# NitiPath Backend - Environment Variables
# ========================================================
PORT=5000
NODE_ENV=development

# Database Connection (Supabase PostgreSQL connection URI)
# Project Settings -> Database -> Connection string -> URI
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<your-project-ref>.supabase.co:5432/postgres?schema=public"

# Supabase Server Configuration
# Project Settings -> API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

JWT_SECRET=nitipath_super_secret_jwt_key_sih2024_2026_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:3001

# Real Email Delivery Configuration (Gmail, Brevo, Resend, or Custom SMTP)
# Option A: Gmail SMTP (Use a 16-character App Password from Google Account Security)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="NitiPath Industrial Portal" <noreply@nitipath.gov.in>

# Option B: Resend API Key (https://resend.com)
RESEND_API_KEY=re_your_api_key

