# ========================================================
# NitiPath Platform - Environment Variables
# ========================================================

# Frontend API URL (Configured in Vercel Project Settings)
# - Local Dev: http://localhost:5000/api
# - Vercel Production: Set to your hosted backend API URL (e.g. https://your-backend.onrender.com/api)
# - If running with Vercel rewrites: /api
VITE_API_URL=http://localhost:5000/api

# Supabase Configuration
# Project Settings -> API in Supabase Dashboard
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
